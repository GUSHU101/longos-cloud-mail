# Copy this file to .cloud-mail.deploy.env. The real file is ignored by Git.
# Run from the repository root: node scripts/deploy-cloudflare.mjs

# Cloudflare credential. Never commit the real token. Account ID is optional
# when the token can access exactly one account; the deployer discovers it.
CLOUDFLARE_API_TOKEN=replace-with-cloudflare-api-token
CLOUDFLARE_ACCOUNT_ID=

# Worker and storage resource names. Existing resources with the same names
# are reused; missing D1, KV and R2 resources are created automatically.
NAME=cloud-mail
D1_DATABASE_NAME=cloud-mail
R2_BUCKET_NAME=cloud-mail-attachments
CUSTOM_DOMAIN=mail.example.com

# One domain can be written directly. Multiple domains may be comma-separated
# or written as a JSON array. ADMIN must use one of these domains.
DOMAIN=example.com
ADMIN=admin@example.com
CORS_ORIGINS=[]

# Optional. Leave blank to generate it securely on first deploy and preserve
# the existing Worker secret on upgrades. Set only when intentionally rotating.
JWT_SECRET=

# Recommended outbound mode. Create one Cloud Mail token in the LONGOS control
# site. This locks delivery to the LONGOS built-in Postfix/OpenDKIM engine and
# disables silent Cloudflare/Resend fallback.
LONGOS_RELAY_URL=https://shop.example.com/_longos/mail-relay
LONGOS_INTEGRATION_TOKEN=longos_it_replace_with_64_characters
RELAY_SHARED_SECRET=

# Optional third-party/advanced features. They are not needed with LONGOS.
CLOUDFLARE_EMAIL=false
ANALYSIS_CACHE=false
AI_MODEL=@cf/meta/llama-3.1-8b-instruct-fast
PROJECT_LINK=https://github.com/GUSHU101/longos-cloud-mail
RESEND_WEBHOOK_SECRET=

# Optional: pin existing resources explicitly. Normally leave blank so the
# deployment tool safely looks them up by the names above.
D1_DATABASE_ID=
KV_NAMESPACE_ID=
