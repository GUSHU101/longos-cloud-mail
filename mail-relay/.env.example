# Public DNS name used by Postfix EHLO. Its A record and server PTR must match.
MAIL_HOSTNAME=mailout.example.com

# Comma-separated domains that this relay is allowed to send from.
MAIL_DOMAINS=example.com
ALLOWED_SENDER_DOMAINS=example.com

# Generate with: openssl rand -hex 32
# Standalone Cloud Mail can use this compatibility key. Integrated LONGOS
# deployments should prefer the isolated client keys below.
RELAY_SHARED_SECRET=replace-with-at-least-32-random-characters
# Client-isolated keys restrict each signer to its senderContext.source. At
# least one of these three secret variables must contain 32+ characters.
LONGOS_RELAY_SHARED_SECRET=
CLOUD_MAIL_RELAY_SHARED_SECRET=

DKIM_SELECTOR=mail2026
INET_PROTOCOLS=ipv4
RELAY_HTTP_PORT=8788
MAX_REQUEST_BYTES=26214400
MAX_ATTACHMENT_BYTES=20971520
MAX_RECIPIENTS=50
MAX_REQUESTS_PER_MINUTE=120
MAX_REQUESTS_PER_MINUTE_GLOBAL=1200
MAX_CONCURRENT_SENDS=25
MAX_CONNECTIONS=100
MAX_REQUESTS_PER_SOCKET=100
HEALTH_CACHE_TTL_MS=5000
SIGNATURE_WINDOW_SECONDS=300
