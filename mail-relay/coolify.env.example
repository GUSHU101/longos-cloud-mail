# Paste public values in Coolify's Developer view. Enter the three secrets in
# Normal view, mark them Secret, and disable Build Variable for every secret.
# Do not commit or share the real values.

# coolify: buildtime=false
MAIL_HOSTNAME=mailout.example.com
# coolify: buildtime=false
MAIL_PUBLIC_IPS=203.0.113.10
# coolify: buildtime=false
MAIL_DOMAINS=example.com
# coolify: buildtime=false
ALLOWED_SENDER_DOMAINS=example.com
# coolify: buildtime=false
DKIM_SELECTOR=mail2026
# coolify: buildtime=false
INET_PROTOCOLS=ipv4
# coolify: buildtime=false
RELAY_HTTP_PORT=8788
# Keep this stable after the first deployment so Coolify reuses the same DKIM,
# queue and idempotency volumes after resource renames or redeployments.
# coolify: buildtime=false
MAIL_NODE_VOLUME_PREFIX=longos-remote-mail

# Copy SERVICE_PASSWORD_64_MAILRELAY from the primary LONGOS resource.
# coolify: buildtime=false
LONGOS_RELAY_SHARED_SECRET=
# Copy SERVICE_PASSWORD_64_CLOUDMAIL from the primary LONGOS resource.
# coolify: buildtime=false
CLOUD_MAIL_RELAY_SHARED_SECRET=
# Copy only the token string from Cloudflare Networking > Tunnels > Add replica.
# coolify: buildtime=false
TUNNEL_TOKEN=

# Cloudflare Tunnel normally tries QUIC first and falls back to HTTP/2.
# coolify: buildtime=false
TUNNEL_PROTOCOL=auto
# coolify: buildtime=false
TUNNEL_LOG_LEVEL=info
# Metrics stay on loopback and power the container readiness check.
# coolify: buildtime=false
TUNNEL_METRICS_ADDRESS=127.0.0.1:20246
# Version updates should be reviewed before changing this pin.
# coolify: buildtime=false
CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.10.5

# Conservative defaults for a 2 GiB VPS shared with 3X-UI.
# coolify: buildtime=false
RELAY_MEMORY_LIMIT=768m
# coolify: buildtime=false
RELAY_MEMORY_RESERVATION=256m
# coolify: buildtime=false
RELAY_PIDS_LIMIT=256
# coolify: buildtime=false
TUNNEL_MEMORY_LIMIT=256m
# coolify: buildtime=false
TUNNEL_MEMORY_RESERVATION=64m
# coolify: buildtime=false
TUNNEL_PIDS_LIMIT=128
